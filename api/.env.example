# ============================================
# NordcsCare - Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env no repositório!
# ============================================

# Ambiente: development | production
APP_ENV=production

# Banco de Dados
DB_HOST=localhost
DB_NAME=nordcscare
DB_USER=
DB_PASSWORD=

# JWT - Use uma chave forte e aleatória (mín. 32 caracteres)
JWT_SECRET=

# CORS - Origens permitidas (separar por vírgula se múltiplas)
CORS_ORIGIN=https://seudominio.com.br

# HTTPS - Forçar redirecionamento HTTPS em produção
FORCE_HTTPS=true

# RedCheck API
REDCHECK_PARTNER_NAME=
REDCHECK_PARTNER_TOKEN=
